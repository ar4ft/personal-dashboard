---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import News from '../components/News.astro';
import Ideas from '../components/Ideas.astro';
import Todos from '../components/Todos.astro';
import data from '../data/dashboard.json';
import { seedItems } from '../lib/workspace.mjs';
import { route } from '../lib/model.mjs';
const href = (path: string) => route(import.meta.env.BASE_URL,path);
---
<Layout title="Overview"><div hidden data-overview-seed={JSON.stringify(seedItems(data))} data-base={import.meta.env.BASE_URL}></div><div class="page-heading home-heading"><div><p class="eyebrow">{data.name}</p><h1>Things<br />to keep.</h1><p class="intro">Read a story. Save an idea. Make your next move.</p></div><div class="clipping-art" aria-hidden="true"><div class="clip-sheet back-sheet"></div><div class="clip-sheet front-sheet"><span class="paper-tab"></span><Icon name="news" size={44} /><span>Read.<br />Keep.<br />Follow.</span></div></div></div>
<div class="summary-grid"><a class="summary green" href={href('news/')}><span>Your reading list</span><div><h2>News & reading</h2><span aria-hidden="true"><svg class="arrow-icon" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 18 18 6M6 6h12v12" /></svg></span></div><p>{data.news.length} starter links to explore</p></a><a class="summary cream" href={href('ideas/')}><span>Your project board</span><div><h2>Project ideas</h2><span aria-hidden="true"><svg class="arrow-icon" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 18 18 6M6 6h12v12" /></svg></span></div><p>{data.ideas.length} possibilities on the board</p></a><a class="summary lilac" href={href('planning/')}><span>Your next steps</span><div><h2>Todos & calendar</h2><span aria-hidden="true"><svg class="arrow-icon" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 18 18 6M6 6h12v12" /></svg></span></div><p>{data.todos.length} tasks · {data.events.length} sample events</p></a></div>
<div class="overview-grid"><section class="panel"><div class="section-heading"><h2>Worth a read</h2><a href={href('news/')}>All reading <svg class="arrow-icon" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 18 18 6M6 6h12v12" /></svg></a></div><News limit={3} /></section><section class="panel"><div class="section-heading"><h2>On your plan</h2><a href={href('planning/')}>Your plan <svg class="arrow-icon" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 18 18 6M6 6h12v12" /></svg></a></div><Todos filter="Today" /></section></div>
<section class="ideas-section"><div class="section-heading"><h2>Ideas to try</h2><a href={href('ideas/')}>All ideas <svg class="arrow-icon" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 18 18 6M6 6h12v12" /></svg></a></div><Ideas /></section></Layout>

<script>import '../scripts/overview';</script>
