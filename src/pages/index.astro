---
import Layout from '../layouts/Layout.astro';
import News from '../components/News.astro';
import Ideas from '../components/Ideas.astro';
import Todos from '../components/Todos.astro';
import data from '../data/dashboard.json';
import { route } from '../lib/model.mjs';
const href = (path: string) => route(import.meta.env.BASE_URL,path);
---
<Layout title="Overview"><div class="page-heading"><div><p class="eyebrow">YOUR PERSONAL CORNER OF THE INTERNET</p><h1>A little clarity.<br />A little momentum.</h1><p class="intro">Catch up on the world, capture an idea, and make a plan for what comes next.</p></div><div class="date-stamp"><span aria-hidden="true">✳</span><p>A fresh start,<br />whenever you need one.</p></div></div>
<div class="summary-grid"><a class="summary green" href={href('news/')}><span>01 / STAY CURIOUS</span><div><h2>News & reading</h2><span aria-hidden="true"><svg class="arrow-icon" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 18 18 6M6 6h12v12" /></svg></span></div><p>{data.news.length} starter links to explore</p></a><a class="summary cream" href={href('ideas/')}><span>02 / KEEP MAKING</span><div><h2>Project ideas</h2><span aria-hidden="true"><svg class="arrow-icon" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 18 18 6M6 6h12v12" /></svg></span></div><p>{data.ideas.length} possibilities on the board</p></a><a class="summary lilac" href={href('planning/')}><span>03 / FIND YOUR FOCUS</span><div><h2>Todos & calendar</h2><span aria-hidden="true"><svg class="arrow-icon" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 18 18 6M6 6h12v12" /></svg></span></div><p>{data.todos.length} tasks · {data.events.length} sample events</p></a></div>
<div class="overview-grid"><section class="panel"><div class="section-heading"><h2>On your radar</h2><a href={href('news/')}>All reading <svg class="arrow-icon" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 18 18 6M6 6h12v12" /></svg></a></div><News limit={3} /></section><section class="panel"><div class="section-heading"><h2>A small step today</h2><a href={href('planning/')}>Your plan <svg class="arrow-icon" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 18 18 6M6 6h12v12" /></svg></a></div><Todos filter="Today" /><div class="focus-note"><span aria-hidden="true"><svg aria-hidden="true" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 4v12h14m-5-5 5 5-5 5" /></svg></span><p>You don’t have to do it all.<br /><strong>Pick one thing and begin.</strong></p></div></section></div>
<section class="ideas-section"><div class="section-heading"><h2>Room for your next idea</h2><a href={href('ideas/')}>All ideas <svg class="arrow-icon" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 18 18 6M6 6h12v12" /></svg></a></div><Ideas /></section></Layout>
