---
import data from '../data/dashboard.json';
import { seedItems } from '../lib/workspace.mjs';
import '../styles/workspace.css';
interface Props { section: 'news' | 'ideas' | 'planning'; filter?: string }
const { section, filter='All' } = Astro.props;
---
<section id="interactive-workspace" data-section={section} data-subsection={filter} data-seed={JSON.stringify(seedItems(data))} data-base={import.meta.env.BASE_URL}>
<div class="workspace-toolbar"><div class="view-switch" role="group" aria-label="View"><button type="button" data-view="feed">Feed</button><button type="button" data-view="timeline">Timeline</button><button type="button" data-view="board">Kanban</button>{section==='news' && <button type="button" id="news-swipe-launch" class="news-swipe-launch">Swipe news</button>}{section==='planning' && <button type="button" data-view="calendar">Calendar</button>}</div><div class="toolbar-actions"><button type="button" id="new-item" class="primary-button">+ Add item</button><button type="button" id="manage-board">Edit columns</button><button type="button" id="data-settings">Feeds & backup</button></div></div>
<div class="filter-bar"><label class="search-field"><span>Search this section</span><input type="search" id="workspace-search" placeholder="Search titles, content, topics…" /></label><button type="button" id="mobile-filters-toggle" class="mobile-filters-toggle" aria-expanded="false" aria-controls="topic-filter group-filter favorites-filter">Filters</button><label>Topic<select id="topic-filter"><option value="">All topics</option></select></label><label>Group by<select id="group-filter"><option value="none">No grouping</option><option value="topics">Topic</option></select></label><button type="button" id="favorites-filter" aria-pressed="false">☆ Favorites</button><button type="button" id="swipe-toggle" aria-pressed="false">Sideways cards</button></div>
<div class="workspace-meta"><p id="results-count" aria-live="polite"></p><p id="save-status" role="status">Saved in this browser · export to back up</p></div>
<div id="workspace-content" aria-label="Section items"></div>
<p id="action-status" class="action-status" role="status" aria-live="polite"></p>
<noscript><p class="panel">Enable JavaScript to use boards, feeds, favorites, search, and editing. Your content is available in the repository.</p></noscript>
{section==='news' && <dialog id="news-swipe-dialog" aria-labelledby="news-swipe-title"><div class="reels-topbar"><button type="button" data-close="news-swipe-dialog" aria-label="Close swipe news">←</button><div><h2 id="news-swipe-title">Your news</h2><span id="news-swipe-position" aria-live="polite"></span></div><div class="reels-navigation"><button type="button" id="news-swipe-previous" aria-label="Previous story">↑</button><button type="button" id="news-swipe-next" aria-label="Next story">↓</button></div></div><div id="news-swipe-scroller" tabindex="0" aria-label="Swipe up or down to browse news"></div><p id="news-swipe-status" role="status" aria-live="polite"></p></dialog>}
<dialog id="detail-dialog" aria-labelledby="detail-title"><div class="dialog-top"><span class="eyebrow">ITEM DETAILS</span><button type="button" data-close="detail-dialog" aria-label="Close details">✕</button></div><div id="detail-body"></div><div class="detail-navigation"><button type="button" id="detail-previous">← Previous</button><span id="detail-position"></span><button type="button" id="detail-next">Next →</button></div></dialog>
<dialog id="edit-dialog" aria-labelledby="edit-title"><div class="dialog-top"><h2 id="edit-title">Edit item</h2><button type="button" data-close="edit-dialog" aria-label="Close editor">✕</button></div><form id="item-form"><label>Title<input name="title" required maxlength="500" /></label><div class="form-pair"><label>Type<select name="type"><option value="news">News</option><option value="idea">Idea</option><option value="task">Task</option><option value="event">Calendar event</option></select></label><label>Board column<select name="status"></select></label></div><label>Topics, separated by commas<input name="topics" placeholder="Technology, Design" /></label><label>Summary<textarea name="description" rows="3"></textarea></label><label>Full text / notes<textarea name="content" rows="7" placeholder="Article text supplied by your feed, or your own reading notes. Plain text is supported."></textarea></label><div class="form-pair"><label>Source<input name="source" placeholder="Hacker News, Twitter / X…" /></label><label>Source URL<input name="url" type="url" placeholder="https://…" /></label></div><label>Author / account<input name="author" placeholder="e.g. @builder or publication author" /></label><div class="form-pair"><label>Cover image URL or local path<input name="image" placeholder="https://… or media/story.jpg" /></label><label>Image description<input name="imageAlt" placeholder="Describe the image for screen readers" /></label></div><div class="form-pair" id="event-fields"><label>Date / due date<input name="date" type="date" /></label><label>Time<input name="time" type="time" /></label></div><label id="next-step-field">Next step<input name="nextStep" /></label><label id="task-group-field">Task group<select name="group"><option value="">No group</option><option>Today</option><option>Upcoming</option><option>Someday</option></select></label><p id="form-error" class="form-error" role="alert"></p><div class="form-buttons"><button type="button" data-close="edit-dialog">Cancel</button><button type="submit" class="primary-button">Save item</button></div></form></dialog>
<dialog id="columns-dialog" aria-labelledby="columns-title"><div class="dialog-top"><h2 id="columns-title">Your board columns</h2><button type="button" data-close="columns-dialog" aria-label="Close columns editor">✕</button></div><p class="dialog-intro">Rename, reorder, or remove columns. Removing a column moves its cards to the first remaining column.</p><div id="columns-list"></div><form id="column-form" class="inline-form"><label>New column<input name="column" required maxlength="80" placeholder="e.g. Worth exploring" /></label><button type="submit">Add column</button></form><p id="column-error" class="form-error" role="alert"></p></dialog>
<dialog id="settings-dialog" aria-labelledby="settings-title"><div class="dialog-top"><h2 id="settings-title">Feeds & backup</h2><button type="button" data-close="settings-dialog" aria-label="Close feeds and backup">✕</button></div><p class="dialog-intro">Boards, notes, and favorites save in this browser. Export a backup to move your workspace to another device.</p><div class="settings-section"><h3>Automated feed</h3><p><a class="source-link" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/llms.txt`} target="_blank" rel="noopener noreferrer">Read the agent content guide</a></p><p>The dashboard checks <code>feed.json</code> on load and every five minutes. Your automation can commit that file. You can also connect a public JSON URL that permits browser access (CORS).</p><form id="feed-form"><label>Optional public feed URL<input name="feedUrl" type="url" placeholder="https://example.com/feed.json" /></label><button type="submit">Save & refresh feeds</button></form><p id="feed-status" role="status"></p><button type="button" id="refresh-feed">Refresh now</button><label class="file-button">Import feed JSON<input type="file" id="feed-import" accept=".json,application/json" /></label><p>Feeds add or update items by stable ID. Your favorites, notes, and board positions are preserved.</p></div><div class="settings-section"><h3>Backup & restore</h3><button type="button" id="export-backup">Export workspace</button><label class="file-button">Restore backup<input type="file" id="backup-import" accept=".json,application/json" /></label><p>Restoring replaces this browser’s workspace. A recovery backup downloads first.</p></div><p id="settings-status" role="status"></p></dialog>
</section>
<script>import '../scripts/workspace';</script>
