---
import data from '../data/dashboard.json';
import { select } from '../lib/model.mjs';
const { filter = 'All' } = Astro.props;
---
<div class="todo-list">{select(data.todos,'group',filter).map(item => <label class="todo-row"><input type="checkbox" data-task-id={item.id} checked={item.done} /><span>{item.title}</span><small>{item.group}</small></label>)}</div>
<p class="hint" id="task-storage-note">Checkmarks are saved in this browser. Edit tasks in Todos & calendar.</p>
