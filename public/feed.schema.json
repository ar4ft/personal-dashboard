{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Personal dashboard feed",
  "type": "object",
  "required": ["version", "items"],
  "properties": {
    "version": {
      "const": 1
    },
    "items": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": ["id", "section", "title"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "not": {
              "enum": ["__proto__", "constructor", "prototype"]
            }
          },
          "section": {
            "enum": ["news", "ideas", "planning"]
          },
          "type": {
            "enum": ["news", "idea", "task", "event"]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "url": {
            "type": "string",
            "pattern": "^(https?://|$)"
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "time": {
            "type": "string",
            "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "done": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "nextStep": {
            "type": "string"
          },
          "group": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "section": {
                  "const": "news"
                }
              },
              "required": ["section"]
            },
            "then": {
              "properties": {
                "type": {
                  "enum": ["news"]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "section": {
                  "const": "ideas"
                }
              },
              "required": ["section"]
            },
            "then": {
              "properties": {
                "type": {
                  "enum": ["idea"]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "section": {
                  "const": "planning"
                }
              },
              "required": ["section"]
            },
            "then": {
              "properties": {
                "type": {
                  "enum": ["task", "event"]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "event"
                }
              },
              "required": ["type"]
            },
            "then": {
              "required": ["date"]
            }
          }
        ]
      }
    }
  }
}
